{
  "name": "@greenlight/render",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "render": "tsx src/render.ts",
    "render:fixture": "tsx src/render.ts --fixture",
    "still": "remotion still src/index.ts GreenlightThumbnail out/thumbnail.png --frame=0",
    "studio": "remotion studio src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@greenlight/contracts": "workspace:*",
    "@remotion/bundler": "4.0.515",
    "@remotion/captions": "4.0.515",
    "@remotion/cli": "4.0.515",
    "@remotion/google-fonts": "4.0.515",
    "@remotion/layout-utils": "4.0.515",
    "@remotion/media": "4.0.515",
    "@remotion/renderer": "4.0.515",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.515",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
