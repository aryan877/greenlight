{
  "name": "greenlight-producer",
  "manifest": {
    "model": {
      "name": "greenlight/root-model",
      "params": {
        "max_tokens": 16384,
        "temperature": 0.35,
        "parallel_tool_calls": true
      }
    },
    "skills": [
      { "name": "marketing-editor" },
      { "name": "evidence-desk" },
      { "name": "youtube-release" },
      { "name": "edit-decision" }
    ],
    "mcp_servers": [
      {
        "name": "greenlight",
        "enable_tools": ["@all"],
        "disable_tools": [],
        "preload": false,
        "preload_tools": [
          "update_production_plan",
          "create_project",
          "get_project",
          "get_artifact",
          "get_media_capabilities",
          "search_media_library",
          "import_media_library_asset",
          "search_openmoji",
          "attach_openmoji",
          "save_evidence_ledger",
          "save_content_package",
          "apply_editor_patch",
          "focus_editor_selection",
          "generate_image",
          "generate_voice",
          "transcribe_audio",
          "render_video",
          "run_quality_checks"
        ],
        "require_approval_for_tools": [
          "apply_editor_patch",
          "render_video",
          "stage_video_unlisted",
          "publish_video",
          "schedule_video"
        ]
      },
      {
        "name": "exa",
        "enable_tools": ["@all"],
        "disable_tools": [],
        "preload": false,
        "preload_tools": [],
        "require_approval_for_tools": []
      }
    ],
    "config": {
      "iteration_limit": 80,
      "sandbox": {
        "enabled": true,
        "file_downloads": true
      },
      "dynamic_sub_agents": {
        "enabled": true
      },
      "context_management": {
        "compaction": {
          "enabled": true
        },
        "large_tool_response": {
          "enabled": true
        }
      },
      "generative_ui": {
        "enabled": true
      },
      "ask_user_questions": {
        "enabled": true
      }
    }
  }
}
