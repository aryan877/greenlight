# TrueForge root model (choose one supported route; never commit real values)
GREENLIGHT_ROOT_MODEL=deepseek/deepseek-v4-flash-vision-exp
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Local services
TRUEFORGE_API_URL=http://localhost:8790
GREENLIGHT_MCP_URL=http://localhost:8941/mcp
GREENLIGHT_MCP_PORT=8941
GREENLIGHT_STUDIO_PORT=4173
GREENLIGHT_DATA_DIR=./data
GREENLIGHT_ARTIFACT_DIR=./artifacts
GREENLIGHT_YOUTUBE_PROFILE=main
GREENLIGHT_YOUTUBE_CHANNEL_ID=
GREENLIGHT_YOUTUBE_UPLOADER=/Users/aryankumar/youtube-uploader/.venv/bin/youtube-uploader

# Optional media providers
GREENLIGHT_IMAGE_PROVIDER=codex_subscription
GREENLIGHT_CODEX_BINARY=codex
GREENLIGHT_CODEX_MODEL=
GREENLIGHT_ENABLE_OPENAI_IMAGE_API=false
GREENLIGHT_ENABLE_OPENROUTER_IMAGE_API=false
GREENLIGHT_VOICE_PROVIDER=openrouter
GREENLIGHT_VOICE_MODEL=google/gemini-3.1-flash-tts-preview
GREENLIGHT_VOICE_ID=Kore
GREENLIGHT_TRANSCRIPTION_PROVIDER=openai
GREENLIGHT_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
GREENLIGHT_TRANSCRIPTION_TIMING_MODEL=whisper-1
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
