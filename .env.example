# TrueForge and every generated-media provider use this one OpenRouter key.
GREENLIGHT_ROOT_MODEL=deepseek/deepseek-v4-flash-vision-exp
OPENROUTER_API_KEY=
GREENLIGHT_MCP_AUTH_TOKEN=
GREENLIGHT_SKILLS_REPO_URL=https://github.com/your-account/greenlight.git
GREENLIGHT_SKILLS_REF=main
GREENLIGHT_ENABLE_GIT_SKILLS=auto

# Local services
TRUEFORGE_API_URL=http://localhost:8790
GREENLIGHT_MCP_URL=http://localhost:8941/mcp
GREENLIGHT_MCP_HOST=127.0.0.1
GREENLIGHT_MCP_PORT=8941
GREENLIGHT_STUDIO_PORT=4173
GREENLIGHT_STUDIO_ORIGIN=http://127.0.0.1:4173
GREENLIGHT_DATA_DIR=./data
GREENLIGHT_ARTIFACT_DIR=./artifacts
GREENLIGHT_OPENMOJI_ROOT=
GREENLIGHT_CHROMIUM_PATH=
# Optional R2-original reader. The artifact directory remains the local hot cache.
GREENLIGHT_R2_READER_URL=
GREENLIGHT_ORIGIN_TOKEN=
GREENLIGHT_YOUTUBE_PROFILE=main
GREENLIGHT_YOUTUBE_UPLOADER=
GREENLIGHT_YOUTUBE_TOKEN_PATH=
GREENLIGHT_YOUTUBE_CLIENT_ID=
GREENLIGHT_YOUTUBE_CLIENT_SECRET=
GREENLIGHT_YOUTUBE_REDIRECT_URI=

# Media providers
PEXELS_API_KEY=
GREENLIGHT_VOICE_ID=Kore
GREENLIGHT_WHISPER_BINARY=whisper-cli
GREENLIGHT_WHISPER_MODEL=
